        <groupId>com.f2f</groupId>
        <artifactId>f2fServer</artifactId>
        <version>0.0.3-SNAPSHOT</version>
    </parent>

    <packaging>war</packaging>
    <artifactId>f2fc</artifactId>
    <version>1.0</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

